# Path to the SQLite database file.
# Locally the application uses ./.data/icarus.sqlite; Compose mounts ./db to /data/db.
DATABASE_PATH=./.data/icarus.sqlite

# Single administrator account (admin login).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Set to "true" behind externally managed HTTPS so the session cookie is Secure.
ADMIN_COOKIE_SECURE=false
