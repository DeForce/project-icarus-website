# Native dependencies ship prebuilt binaries (better-sqlite3, esbuild, Biome), so no install
# scripts are required. Keeping scripts disabled makes `npm ci` reproducible: npm would otherwise
# run an implicit `node-gyp rebuild` for better-sqlite3 (binding.gyp present), which demands a
# C++ toolchain that contributors may not have. If a future dependency genuinely needs an install
# script, revisit this setting deliberately.
ignore-scripts=true
