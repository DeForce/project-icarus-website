# Copied to docker/.env for compose interpolation (docker compose -f docker/compose.yaml up).
# DATABASE_PATH is fixed to /data/db/icarus.sqlite inside the container; do not override here.

# Single administrator account (admin login). Required.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# "true" only behind an external HTTPS terminator (session cookie becomes Secure).
ADMIN_COOKIE_SECURE=false
