{
  "name": "icarus-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node server/database/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "node server/database/seed.ts",
    "db:backup": "node server/database/backup.ts",
    "docs:new": "node scripts/new-plan.mjs"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "markdown-it": "^15.0.3",
    "nuxt": "^4.6.4",
    "reka-ui": "^2.11.0",
    "three": "^0.187.0",
    "vue": "^3.5.44",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
